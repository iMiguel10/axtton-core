# Copia este fichero a .env (cp .env.example .env). El .env no se sube al repositorio.
# Las contraseñas son solo para desarrollo.

# Postgres (servicio db). La imagen crea POSTGRES_DB con este superusuario la
# primera vez que arranca con el volumen vacío; el script de
# deploy/postgres/initdb crea después los tres roles y la base de pruebas.
# Ningún servicio de la aplicación usa el superusuario.
POSTGRES_DB=axtton
POSTGRES_TEST_DB=axtton_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

AXTTON_OWNER_PASSWORD=owner_dev
AXTTON_APP_PASSWORD=app_dev
AXTTON_PLATFORM_PASSWORD=platform_dev

# "db" es el nombre del servicio en compose, no localhost: dentro de Docker,
# localhost es el propio contenedor de la API.
# API y worker, siempre bajo RLS.
DATABASE_URL=postgresql+asyncpg://axtton_app:app_dev@db:5432/axtton
# Solo app/platform/ (cruza talleres).
PLATFORM_DATABASE_URL=postgresql+asyncpg://axtton_platform:platform_dev@db:5432/axtton
# Solo las migraciones (dueño de las tablas).
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://axtton_owner:owner_dev@db:5432/axtton
