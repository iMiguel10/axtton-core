# Variables de producción (compose.prod.yml, docs/guias/despliegue.md). En Coolify,
# en el panel del recurso (Environment Variables); en otro servidor, en un .env
# junto a compose.prod.yml. Este fichero es solo la plantilla: no lleva secretos.
#
# Cada contraseña y clave, distinta y larga. Para generarlas:
#   openssl rand -hex 32

# Dirección pública, sin barra final.
APP_URL=https://axtton.example.com

# Postgres: el superusuario (solo crea los roles) y los tres roles (arquitectura §4).
# Los roles se crean con estas contraseñas SOLO la primera vez, con el volumen
# vacío: cambiarlas después no cambia la de la base de datos.
POSTGRES_PASSWORD=
AXTTON_OWNER_PASSWORD=
AXTTON_APP_PASSWORD=
AXTTON_PLATFORM_PASSWORD=

# SuperTokens: la base de datos del core y la clave con la que la API le habla.
SUPERTOKENS_DB_PASSWORD=
SUPERTOKENS_API_KEY=

# multi (varios talleres) o single (taller único), RF-111.
INSTALLATION_MODE=multi

# Correo (opcional). Sin SMTP_HOST, la aplicación no envía emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=AXTTON CORE <no-reply@axtton.example.com>

# La demo (docs/guias/demo.md): true SOLO en su instalación.
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=

# La versión (decisión 0003): no se rellenan a mano. Las pone el job de
# despliegue de la CI en cada despliegue.
# APP_VERSION=
# APP_COMMIT=
