# Copia este fichero a .env (cp .env.example .env). El .env no se sube al repositorio.
# Las contraseñas son solo para desarrollo.

# Postgres (servicio db). La imagen crea POSTGRES_DB con este superusuario la
# primera vez que arranca con el volumen vacío; el script de
# deploy/postgres/initdb crea después los tres roles y la base de pruebas.
# Ningún servicio de la aplicación usa el superusuario.
POSTGRES_DB=axtton
POSTGRES_TEST_DB=axtton_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

AXTTON_OWNER_PASSWORD=owner_dev
AXTTON_APP_PASSWORD=app_dev
AXTTON_PLATFORM_PASSWORD=platform_dev

# "db" es el nombre del servicio en compose, no localhost: dentro de Docker,
# localhost es el propio contenedor de la API.
# API y worker, siempre bajo RLS.
DATABASE_URL=postgresql+asyncpg://axtton_app:app_dev@db:5432/axtton
# Solo app/platform/ (cruza talleres).
PLATFORM_DATABASE_URL=postgresql+asyncpg://axtton_platform:platform_dev@db:5432/axtton
# Solo las migraciones (dueño de las tablas).
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://axtton_owner:owner_dev@db:5432/axtton

# SuperTokens (arquitectura A4). Su base de datos es otra instancia de Postgres,
# separada de la de la aplicación. El core no publica puertos: solo lo ve `api`.
SUPERTOKENS_DB_NAME=supertokens
SUPERTOKENS_DB_USER=supertokens
SUPERTOKENS_DB_PASSWORD=supertokens_dev
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567
SUPERTOKENS_API_KEY=supertokens-dev-api-key-change-me

# Dirección pública por la que el navegador llega a la aplicación. Con un solo
# dominio (arquitectura §5), la API y el frontend comparten origen: en desarrollo,
# el de Vite, que reenvía /api a la API.
APP_URL=http://localhost:5173

# Correo (RF-68): todo sale de la plataforma. En desarrollo, Mailpit
# (http://localhost:8025). Sin SMTP_HOST, la aplicación arranca igual y no envía
# emails (RNF-32).
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=AXTTON CORE <no-reply@axtton.local>

# Modo de instalación (RF-111): multi (varios talleres) o single (taller único).
INSTALLATION_MODE=multi

# Límite de peticiones (RNF-06): contadores en Valkey. Con RATE_LIMIT_ENABLED=false
# no se limita nada (las pruebas lo apagan y encienden el suyo).
VALKEY_URL=redis://valkey:6379/0
RATE_LIMIT_ENABLED=true
# Proxies propios (IPs o redes CIDR, separadas por comas) cuyo X-Forwarded-For es
# de fiar. Vacío en desarrollo: sin proxy delante, se usa la IP de la conexión.
TRUSTED_PROXIES=

# Datos de demostración (docs/guias/demo.md): python -m app.scripts.seed_demo BORRA
# todos los datos y crea los de la demo. Solo corre con esto a true: en desarrollo y
# en la demo desplegada, sí; en una instalación real, nunca (falsa por defecto).
DEMO_SEED_ENABLED=true
# Contraseña de las cuentas de la demo; vacía, la del script (pública a propósito).
DEMO_PASSWORD=
