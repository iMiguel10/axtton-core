# Copia este fichero a .env (cp .env.example .env). El .env no se sube al repositorio.

# Postgres (servicio db). Con estas variables la imagen crea la base de datos y su
# usuario la primera vez que arranca con el volumen vacío.
POSTGRES_DB=axtton
POSTGRES_USER=axtton
POSTGRES_PASSWORD=axtton

# API. "db" es el nombre del servicio en compose, no localhost: dentro de Docker,
# localhost es el propio contenedor de la API.
DATABASE_URL=postgresql+asyncpg://axtton:axtton@db:5432/axtton
